{
  "description": "Keep track of receipts, warranties, and return deadlines with photo capture and smart remi",
  "secrets": [],
  "llm": {
    "purpose": "Reads receipt photos to fill in item details for you",
    "suggested_daily_cap_cents": 100
  },
  "tests": [
    { "name": "Home empty state", "path": "/", "expectText": "No items yet" },
    {
      "id": "home.welcome",
      "name": "First-run welcome explains the 3 steps",
      "path": "/",
      "expectSelector": "#home-welcome:not([hidden]) #welcome-add",
      "visual": true,
      "impact": ["public/index.html", "styles/**"]
    },
    {
      "id": "items.sort-chips",
      "name": "Filter chips render",
      "path": "/?demo=1",
      "expectSelector": "#filter-store"
    },
    { "name": "Settings button on Home", "path": "/", "expectSelector": "#settings-open[aria-label='Settings']" },
    { "name": "Zoom menu in Settings", "path": "/", "expectSelector": "#settings-dialog #zoom-select option[value='200']" },
    { "name": "Settings button on Add", "path": "/add", "expectSelector": "#settings-open" },
    {
      "id": "items.demo-list",
      "name": "Item list with statuses",
      "path": "/?demo=1",
      "expectText": "Staging demo",
      "visual": true,
      "impact": ["public/**", "server.js", "styles/**", "dapp.json"]
    },
    {
      "id": "items.add-form",
      "name": "Add/confirm form renders",
      "path": "/add",
      "expectSelector": "#item-form",
      "visual": true,
      "impact": ["public/**", "server.js", "styles/**", "dapp.json"]
    },
    {
      "id": "items.demo-detail",
      "name": "Item detail renders",
      "path": "/item/900001?demo=1",
      "expectText": "Warranty ends"
    },
    { "name": "Demo reminders fire", "path": "/?demo=1", "expectText": "warranty ends in 7 days" },
    { "name": "Demo detail countdown", "path": "/item/900004?demo=1", "expectText": "days left" },
    { "name": "Demo detail manual link", "path": "/item/900004?demo=1", "expectText": "Open manual" },
    { "name": "Add form manual field", "path": "/add", "expectSelector": "#f-manual-url" },
    {
      "id": "items.status-summary",
      "name": "Status summary cards",
      "path": "/?demo=1",
      "expectSelector": "#summary:not([hidden]) #summary-expiring",
      "visual": true,
      "impact": ["public/index.html"]
    },
    { "name": "Status summary label", "path": "/?demo=1", "expectText": "Segera habis" }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🧾"
  }
}
